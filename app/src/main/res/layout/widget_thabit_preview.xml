<?xml version="1.0" encoding="utf-8"?>
<!-- Static widget-picker preview: the medium tier with sample data and Obsidian
     colors hardcoded (the picker never runs our RemoteViews binding, so the real
     layouts would show empty). Multicolor lines are split into TextView pairs
     because static XML has no spans. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_preview"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="34dp"
        android:orientation="horizontal"
        android:paddingStart="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="@string/widget_label"
            android:textColor="#DFE2EB"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="🧪"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            style="@style/WidgetPreviewText"
            android:text="you@thabit"
            android:textColor="#2EA043" />

        <TextView
            style="@style/WidgetPreviewText"
            android:text=":~$ "
            android:textColor="#DFE2EB" />

        <TextView
            style="@style/WidgetPreviewText"
            android:text="cat habits.test"
            android:textColor="#8B949E" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="33dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:orientation="horizontal">

            <TextView
                style="@style/WidgetPreviewText"
                android:text="2026-08-21  "
                android:textColor="#8B949E" />

            <TextView
                style="@style/WidgetPreviewText"
                android:text="▓▓▓▓▓░░░░░"
                android:textColor="#2EA043" />

            <TextView
                style="@style/WidgetPreviewText"
                android:text=" 3/6"
                android:textColor="#FFA657" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:orientation="horizontal">

            <TextView
                style="@style/WidgetPreviewText"
                android:text="[x]"
                android:textColor="#2EA043" />

            <TextView
                style="@style/WidgetPreviewText"
                android:text=" meditate 10 min"
                android:textColor="#DFE2EB" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="30dp"
            android:orientation="horizontal">

            <TextView
                style="@style/WidgetPreviewText"
                android:text="[ ]"
                android:textColor="#DFE2EB" />

            <TextView
                style="@style/WidgetPreviewText"
                android:text=" read 20 pages"
                android:textColor="#DFE2EB" />
        </LinearLayout>

        <TextView
            style="@style/WidgetPreviewText"
            android:minHeight="30dp"
            android:text="# 3 pending — tap to pass"
            android:textColor="#8B949E" />
    </LinearLayout>
</LinearLayout>
