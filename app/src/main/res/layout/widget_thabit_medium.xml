<?xml version="1.0" encoding="utf-8"?>
<!-- The mockup tier: terminal window with header, prompt and 4 body lines.
     Every body line is its own tap target (check-off from the home screen), which
     is why @style/WidgetBodyLine gives them a minHeight the siblings' lines have
     no need for.
     All texts and colors are bound at render time (theme-aware); RemoteViews
     constraint: dividers/guides are ImageViews, plain <View> is not whitelisted.
     fontFamily="monospace" (not JetBrains Mono) — see @style/WidgetBodyLine:
     since CVE-2021-0567 the launcher inflates widget layouts in a restricted
     context that silently drops @font/ resources (series decision).

     No refresh control in the title bar, unlike the siblings: thabit has nothing
     to fetch — no network, no sensor — so a refresh glyph would be a button that
     re-reads a database the widget already re-reads whenever it changes. The
     48dp the siblings spend on it goes to the title instead. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_fill" />

    <ImageView
        android:id="@+id/widget_bg_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:orientation="horizontal">

            <!-- The siblings put their refresh control here, 48dp wide, and the
                 title reads centred because of it. thabit has nothing to refresh
                 (no network, no sensor), so the box stays and the glyph goes:
                 dropping it outright left the title hanging off the left edge
                 and the two widgets stopped looking like siblings on the same
                 home screen. An empty TextView because RemoteViews whitelists
                 few view types, and this is one of them. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:minWidth="48dp" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center"
                android:singleLine="true"
                android:textStyle="bold"
                android:textSize="15sp" />

            <!-- Default font family on purpose: the color-emoji font must kick in -->
            <TextView
                android:id="@+id/widget_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="48dp"
                android:textSize="18sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/widget_guide"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_line1"
                    style="@style/WidgetBodyLine" />

                <TextView
                    android:id="@+id/widget_line2"
                    style="@style/WidgetBodyLine" />

                <TextView
                    android:id="@+id/widget_line3"
                    style="@style/WidgetBodyLine" />

                <TextView
                    android:id="@+id/widget_line4"
                    style="@style/WidgetBodyLine" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
