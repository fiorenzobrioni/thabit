<?xml version="1.0" encoding="utf-8"?>
<!-- Default locale = English: automatic fallback for unsupported device languages.
     Rule of the fake-editor design (series-wide): "code" (YAML/JSON keys, filenames,
     terminal errors, comments) stays English everywhere; only chrome, accessibility
     text and user-facing DATA values are localized. -->
<resources>
    <string name="app_name" translatable="false">thabit</string>

    <!-- Bottom navigation -->
    <string name="nav_editor">Editor</string>
    <string name="nav_log">Log</string>
    <string name="nav_stats">Stats</string>
    <string name="nav_settings">Settings</string>

    <!-- Accessibility. VISION §3.3.7: the glyph is the look, the words are the
         meaning — a screen reader must never read "left bracket dot right
         bracket". These are the spoken half of every checkbox state; the row
         composes them with its live detail ("passed, 07:12"). -->
    <string name="cd_add_test">Add a test to the suite</string>
    <string name="cd_state_passed">passed</string>
    <string name="cd_state_pending">still to do</string>
    <string name="cd_state_holding">holding, it fails only if you break it</string>
    <string name="cd_state_skipped">skipped</string>
    <string name="cd_state_failed">failed</string>

    <!-- The main file's rows. Each row offers two targets: the checkbox runs the
         test, the name unfolds its spec. The action labels say what the tap will
         DO, never what the glyph looks like. -->
    <string name="cd_action_pass">Mark as done</string>
    <string name="cd_action_undo">Undo</string>
    <string name="cd_action_log_value">Enter a value</string>
    <string name="cd_action_break">Mark as broken</string>
    <string name="cd_action_details_show">Show details</string>
    <string name="cd_action_details_hide">Hide details</string>
    <string name="cd_row_details">Details of %1$s</string>
    <string name="cd_action_increment">Add %1$s</string>
    <string name="cd_action_note">Add a note</string>
    <string name="cd_action_skip">Skip this test</string>
    <string name="cd_action_unskip">Take back the skip, from today on</string>
    <string name="cd_action_edit">Edit this test</string>
    <string name="cd_action_archive">Archive this test</string>
    <string name="cd_action_archive_confirm">Confirm: archive this test</string>
    <string name="cd_action_cancel">Cancel</string>
    <string name="cd_action_confirm">Confirm</string>
    <string name="cd_action_show_not_due">Show the tests not due today</string>
    <string name="cd_action_hide_not_due">Hide the tests not due today</string>
    <string name="cd_action_skip_window">Change how long the skip lasts</string>
    <string name="cd_not_due">not due today</string>

    <!-- Live detail, spoken. The comment channel says the same thing in English
         because a comment is source; this is the half that speaks the reader's
         language, and no fact ever lives in only one of the two. -->
    <string name="cd_detail_at">at %1$s</string>
    <string name="cd_detail_counter">%1$s of %2$s %3$s</string>
    <string name="cd_detail_counter_done">%1$s %2$s</string>
    <string name="cd_detail_until">until %1$s</string>
    <string name="cd_detail_quota">%1$d of %2$d this week</string>

    <!-- Status bar. The git decorations are signature, not information, so the
         spoken version states the plain fact instead of the glyph. -->
    <plurals name="cd_status_suite">
        <item quantity="one">%1$d test in the suite</item>
        <item quantity="other">%1$d tests in the suite</item>
    </plurals>
    <string name="cd_status_passed">%1$d of %2$d passed</string>

    <!-- settings.config. The file itself is source and stays English; these are
         the sentences a screen reader gets instead of `"day_ends": "03:00"`. -->
    <string name="cd_setting_day_ends">The day ends at %1$s</string>
    <string name="cd_setting_week_starts">The week starts on %1$s</string>
    <string name="cd_setting_line_numbers">Line numbers, %1$s</string>
    <string name="cd_setting_word_wrap">Word wrap, %1$s</string>
    <string name="cd_setting_theme">Theme %1$s</string>
    <string name="cd_setting_theme_active">Theme %1$s, in use</string>
    <string name="cd_setting_version">Version %1$s</string>
    <string name="cd_value_on">on</string>
    <string name="cd_value_off">off</string>
    <string name="cd_action_change">Change</string>
    <string name="cd_action_use_theme">Use this theme</string>
    <string name="cd_action_restore">Restore the settings file</string>
    <string name="cd_action_restore_confirm">Confirm: restore the settings file</string>
    <string name="cd_action_export_json">Export your data as JSON</string>
    <string name="cd_action_export_csv">Export your data as CSV</string>
    <string name="cd_last_modified">Settings last changed on %1$s</string>

    <!-- The wizard: the app's first sixty seconds, so §3.3.7 is held harder here
         than anywhere else. Every token the transcript offers has its plain
         meaning spoken beside it — nobody should need the word "boolean". -->
    <string name="cd_wizard_name">Name of the test</string>
    <string name="cd_type_boolean">yes or no</string>
    <string name="cd_type_counter">a number to reach</string>
    <string name="cd_type_avoid">something to stay away from</string>
    <string name="cd_when_daily">every day</string>
    <string name="cd_when_weekdays">on chosen days of the week</string>
    <plurals name="cd_when_quota">
        <item quantity="one">once a week</item>
        <item quantity="other">%1$d times a week</item>
    </plurals>
    <plurals name="cd_when_interval">
        <item quantity="one">every day</item>
        <item quantity="other">every %1$d days</item>
    </plurals>
    <string name="cd_wizard_chosen">%1$s, chosen</string>
    <string name="cd_wizard_choose">Choose: %1$s</string>
    <string name="cd_wizard_weekday_on">%1$s, included</string>
    <string name="cd_wizard_weekday_off">%1$s, not included</string>
    <string name="cd_wizard_unit">What you are counting: %1$s</string>
    <string name="cd_wizard_target">How much counts as done: %1$s</string>
    <string name="cd_wizard_emoji">Emoji: %1$s</string>
    <string name="cd_wizard_emoji_none">no emoji</string>
    <string name="cd_action_more">Show the remaining questions</string>
    <string name="cd_action_add_test">Add the test to the suite</string>
    <string name="cd_action_save_test">Save the changes</string>
    <string name="cd_action_add_another">Add another test</string>
    <string name="cd_action_close_confirm">Confirm: leave and discard this test</string>
    <string name="cd_action_close">Close</string>
    <string name="cd_wizard_added">%1$s added to the suite</string>
    <!-- habits_history.diff. The log is where the CI vocabulary is thickest, so
         the spoken half is held hardest here: a verdict never arrives without
         the arithmetic that explains it, and a hash never carries a fact of its
         own (VISION §3.3.7). -->
    <plurals name="cd_status_commits">
        <item quantity="one">%1$d committed day</item>
        <item quantity="other">%1$d committed days</item>
    </plurals>
    <string name="cd_status_head">The newest commit</string>
    <string name="cd_log_commit">Commit of %1$s</string>
    <string name="cd_log_commit_show">Show what ran that day</string>
    <string name="cd_log_commit_hide">Hide what ran that day</string>
    <string name="cd_log_amended">edited after the day closed</string>
    <string name="cd_log_amendable">You can still change this day until %1$s</string>
    <string name="cd_log_amend">Change this day</string>
    <string name="cd_log_tag">record: %1$s</string>
    <string name="cd_log_week">Week %1$d, %2$s passed</string>
    <string name="cd_log_quota">%1$s, %2$d of %3$d this week</string>
    <string name="cd_build_passed">everything passed (%1$s)</string>
    <string name="cd_build_unstable">some passed, some did not (%1$s)</string>
    <string name="cd_build_failed">nothing passed (%1$s)</string>
    <!-- README.md. A README is prose, not source, so this is the one file that
         localizes completely, headings included (VISION 1.3). It is also the
         app's plain-language layer: every sentence here is a gloss of a term the
         other files are showing right now (3.3.7). No glossary section: the
         explanation lives inside the prose that is already there. -->
    <string name="readme_h_today">Today</string>
    <string name="readme_h_status">Where things stand</string>
    <string name="readme_h_week">This week</string>
    <string name="readme_clause_separator">, </string>
    <string name="readme_empty_suite">There are no tests yet. Add the first one from the habits.test tab.</string>
    <string name="readme_nothing_due">Nothing is due today.</string>
    <plurals name="readme_today_passed">
        <item quantity="one">%1$d of %2$d done</item>
        <item quantity="other">%1$d of %2$d done</item>
    </plurals>
    <plurals name="readme_today_pending">
        <item quantity="one">%1$d still to do</item>
        <item quantity="other">%1$d still to do</item>
    </plurals>
    <plurals name="readme_today_failed">
        <item quantity="one">%1$d not done</item>
        <item quantity="other">%1$d not done</item>
    </plurals>
    <plurals name="readme_today_skipped">
        <item quantity="one">%1$d skipped</item>
        <item quantity="other">%1$d skipped</item>
    </plurals>
    <!-- The [.] gloss: the one glyph nobody has met anywhere else. -->
    <string name="readme_holds">“%1$s” asks nothing of you: it counts as done unless you say you broke it.</string>
    <!-- The three build verdicts, in words instead of the badge glyphs. -->
    <string name="readme_status_all">Everything due so far has been done: %1$d of them.</string>
    <string name="readme_status_some">So far %1$d of the %2$d you have answered are done.</string>
    <string name="readme_status_none">None of the %1$d you have answered are done yet.</string>
    <string name="readme_yesterday">Yesterday: %1$d of %2$d done.</string>
    <string name="readme_amended">You changed yesterday after it had closed, so its entry in the history says it was edited.</string>
    <plurals name="readme_streak_days">
        <item quantity="one">“%1$s” has been going for %2$d day.</item>
        <item quantity="other">“%1$s” has been going for %2$d days.</item>
    </plurals>
    <plurals name="readme_streak_weeks">
        <item quantity="one">“%1$s” has hit its weekly target for %2$d week.</item>
        <item quantity="other">“%1$s” has hit its weekly target for %2$d weeks.</item>
    </plurals>
    <string name="readme_health_low">“%1$s” has held about %2$s of the time lately.</string>
    <!-- The `no run` gloss: the app is allowed to not know (3.3.8). -->
    <string name="readme_no_run">You did not open the app on %1$s: that day is not counted as failed, it simply is not there.</string>
    <string name="readme_col_day">Day</string>
    <string name="readme_col_passed">Done</string>
    <string name="readme_col_result">How it went</string>
    <string name="readme_result_all">all</string>
    <string name="readme_result_some">some</string>
    <string name="readme_result_none">none</string>
    <string name="readme_result_open">still open</string>
    <string name="readme_result_not_opened">app not opened</string>
    <plurals name="readme_footer">
        <item quantity="one">Worked out on this device · %1$d day recorded</item>
        <item quantity="other">Worked out on this device · %1$d days recorded</item>
    </plurals>
</resources>
