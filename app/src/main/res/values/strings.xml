    <string name="nav_settings">Settings</string>

    <!-- Accessibility. VISION §3.3.7: the glyph is the look, the words are the
         meaning — a screen reader must never read "left bracket dot right
         bracket". These are the spoken half of every checkbox state; the row
         composes them with its live detail ("passed, 07:12"). -->
    <string name="cd_add_test">Add a test to the suite</string>
