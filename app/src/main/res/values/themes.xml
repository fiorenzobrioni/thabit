<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Thabit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <!-- Dark-only app: system bar icons must stay light even when the phone is
             in light mode, or they vanish into the Obsidian background. Set here as
             well as in MainActivity so the window is right before Compose starts. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Cold-start splash: Obsidian background + the { [x] } brand mark, then
         hands over to Theme.Thabit (installSplashScreen() in MainActivity). -->
    <style name="Theme.Thabit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Thabit</item>
        <!-- Theme.SplashScreen is not a Theme.Thabit child: repeat the light-bar
             opt-out so the splash window doesn't flash dark status bar icons. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- One body line of the home widget.

         `monospace` and not JetBrains Mono, and that is not an oversight: since
         CVE-2021-0567 the launcher inflates widget layouts in a restricted
         context that silently drops @font/ resources, so the app's one
         typography exception lives here (series decision, VISION §1.2).

         `minHeight` is thabit's own addition to the inherited style: in the
         siblings a body line is text, here it is a **control** — every row
         checks a test off — and a 23dp strip is a mean target for a gesture that
         writes. It is still short of the 48dp a screen would give it: a widget's
         height is the user's, and the honest trade is a row you can hit rather
         than a row you cannot see. -->
    <style name="WidgetBodyLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- One colored fragment of the static picker preview (colors inline there). -->
    <style name="WidgetPreviewText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
